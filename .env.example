APP_NAME=user-service
AWS_ACCESS_KEY_ID=aws-access-key-id
AWS_DEFAULT_REGION=eu-central-1
AWS_SECRET_ACCESS_KEY=aws-secret-access-key
DEBUG=false
DEFAULT_TIMEZONE=UTC
JWT_SECRET_SSM_PARAM_NAME=/dev/secrets/jwt-secret
LOG_LEVEL=INFO
POWERTOOLS_LOGGER_LOG_EVENT=false
POWERTOOLS_SERVICE_NAME=user-service
POWERTOOLS_DEBUG=false
CORS_ALLOWED_ORIGINS=["http://localhost:8080","https://admin.example.com"]
RATE_LIMITING=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_DURATION_IN_SECONDS=60
STAGE=staging